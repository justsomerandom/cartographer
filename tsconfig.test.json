{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "outDir": ".tmp-test",
    "noEmit": false,
    "incremental": false,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "tsBuildInfoFile": ".tmp-test/tsconfig.test.tsbuildinfo",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/components/dashboard/**/*.tsx", "src/features/**/*.ts", "src/features/**/*.tsx", "src/lib/**/*.ts", "src/server/**/*.ts", "src/types/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx"],
  "exclude": ["node_modules", ".next", ".tmp-test"]
}
